<% submitters = @template.submitters.reject { |e| e['invite_by_uuid'].present? || e['optional_invite_by_uuid'].present? || e['invite_via_field_uuid'].present? } %>
<% signer_colors = %w[bg-blue-500 bg-green-500 bg-orange-500 bg-red-500 bg-yellow-300 bg-purple-600 bg-pink-500 bg-cyan-500 bg-lime-500 bg-indigo-500] %>
<% can_send_emails = Accounts.can_send_emails?(current_account) %>
<% default_subject = @template.preferences['request_email_subject'].presence || "Please sign: #{@template.name}" %>
<% default_body = @template.preferences['request_email_body'].presence || "Please review and sign \"#{@template.name}\".\n\n[Review and Sign]({submitter.link})" %>
<%= render 'shared/turbo_modal_large', title: t('send') do %>
  <%= form_for '', url: template_submissions_path(@template), html: { autocomplete: 'off', id: 'apex_send_form' }, data: { turbo_frame: :_top } do |f| %>
    <%= hidden_field_tag :is_custom_message, '1' %>
    <%= hidden_field_tag :send_email, can_send_emails ? '1' : '0' %>
    <div class="px-5 pt-5 pb-5 space-y-5">
      <div class="space-y-3">
        <% submitters.each_with_index do |item, index| %>
          <% prefill_self = (params[:selfsign] && index.zero?) || item['is_requester'] %>
          <div class="rounded-xl border border-base-300 bg-base-100 px-3 py-3">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-3.5 h-3.5 rounded-full flex-shrink-0 <%= signer_colors[index % signer_colors.length] %>"></span>
              <span class="text-sm font-semibold"><%= item['name'] %></span>
            </div>
            <input type="hidden" name="submission[1][submitters][][uuid]" value="<%= item['uuid'] %>">
            <div class="grid sm:grid-cols-2 gap-2">
              <label class="form-control">
                <span class="label-text text-xs mb-1">Name</span>
                <%= tag.input type: 'text', name: 'submission[1][submitters][][name]', autocomplete: 'name', class: 'base-input !h-10 w-full', placeholder: 'Name', value: prefill_self ? current_user.full_name : '', dir: 'auto', id: "send_name_#{item['uuid']}" %>
              </label>
              <label class="form-control">
                <span class="label-text text-xs mb-1">Email</span>
                <%= tag.input type: 'email', name: 'submission[1][submitters][][email]', autocomplete: 'email', class: 'base-input !h-10 w-full', placeholder: 'Email', required: true, value: item['email'].presence || (prefill_self ? current_user.email : ''), id: "send_email_#{item['uuid']}" %>
              </label>
            </div>
          </div>
        <% end %>
      </div>
      <div class="space-y-3">
        <label class="form-control" for="send_subject">
          <span class="label-text font-semibold mb-1">Email Subject</span>
          <%= f.text_field :subject, value: default_subject, required: true, class: 'base-input w-full', dir: 'auto', id: 'send_subject' %>
        </label>
        <label class="form-control" for="send_message">
          <span class="label-text font-semibold mb-1">Email Message</span>
          <%= f.text_area :body, value: default_body, required: true, rows: 5, class: 'base-textarea w-full', placeholder: 'What is this document about?', dir: 'auto', id: 'send_message' %>
        </label>
      </div>
      <% if !Docuseal.multitenant? && !can_send_emails %>
        <div class="alert">
          <%= svg_icon('info_circle', class: 'w-6 h-6') %>
          <div>
            <p class="font-bold"><%= t('smtp_not_configured') %></p>
            <p>
              <%= t('configure_smtp_settings_in_order_to_send_emails_') %>
              <a class="link font-medium" data-turbo-frame="_top" href="<%= settings_email_index_path %>"><%= t('go_to_smtp_settings') %></a>
            </p>
          </div>
        </div>
      <% end %>
      <div class="form-control">
        <%= f.button class: 'base-button w-full', id: 'apex_send_button' do %>
          <%= button_title(title: t('send'), disabled_with: t('sending')) %>
        <% end %>
      </div>
    </div>
  <% end %>
  <%= render 'submissions/error' %>
<% end %>
